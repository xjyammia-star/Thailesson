rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'points', 'streak', 'unlockedAchievements']) &&
             data.userId is string &&
             data.points is number &&
             data.streak is number &&
             data.unlockedAchievements is list;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isSignedIn() && isOwner(userId) && isValidUser(request.resource.data) &&
                    request.resource.data.userId == resource.data.userId; // Immutable userId
    }
  }
}
